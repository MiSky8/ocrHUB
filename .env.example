# Copy this file to .env and edit it - .env is gitignored, this template isn't.
# `docker compose up --build` reads .env automatically.

# Which optional OCR engines to install at build time (comma-separated
# subset of: surya, paddleocr, datalab). tesseract and pdfplumber are
# always installed. Leave blank for the smallest/fastest image.
ENGINES=

# Datalab hosted OCR API (https://www.datalab.to) - paid, with a free
# monthly tier. Leave DATALAB_API_KEY blank to disable this engine.
DATALAB_API_KEY=
DATALAB_BASE_URL=https://www.datalab.to
DATALAB_MODE=accurate
DATALAB_TIMEOUT=600

# Surya (CPU) memory use: smaller batches are slower but need less RAM. The
# defaults keep it under ~6 GB; if the container gets OOM-killed, lower them
# or raise Docker's memory limit (see README, "Memory, speed and input limits").
SURYA_RECOGNITION_BATCH_SIZE=8
SURYA_DETECTOR_BATCH_SIZE=1
# Surya also runs its layout and table models after recognition, giving
# regions, reading order and tables. Set to 0 for plain lines (faster, less RAM).
# SURYA_LAYOUT=1
# SURYA_LAYOUT_BATCH_SIZE=2
# SURYA_TABLE_REC_BATCH_SIZE=2
# PaddleOCR can also run a layout model (PP-DocLayout-S) after text recognition,
# giving typed regions and figure crops. Set to 1 to turn it on.
# PADDLE_LAYOUT=0
# Layout model (default PP-DocLayout-S; larger ones such as PP-DocLayout-L may find
# more figures but are slower and download on first use) and the minimum 0-1 score
# for a region to be kept (blank = the model's default; lower finds more regions,
# including false ones). Results are cached, so re-run with refresh=true after
# changing either.
# PADDLE_LAYOUT_MODEL=PP-DocLayout-S
# PADDLE_LAYOUT_THRESHOLD=
